<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../AlchiwebApp.Build.props" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>alchiwebapp</ToolCommandName>
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    </PropertyGroup>

    <ItemGroup>
        <!--<PackageReference Include="Rejigs" />-->
        <PackageReference Include="System.CommandLine" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\AlchiwebApp.Cli.Core\AlchiwebApp.Cli.Core.csproj" />
    </ItemGroup>

     <ItemGroup>
       <Compile Remove="Content\**\*.*" />
       <Compile Remove="ModBitPlatformFiles.json" />
     </ItemGroup>

     <ItemGroup>
      <EmbeddedResource Include="Content\**\*.*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </EmbeddedResource>
      <EmbeddedResource Include="ModBitPlatformFiles.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </EmbeddedResource>
     </ItemGroup>

</Project>
